config_version=5

[application]

config/name="Full-Thrust"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

DebugBridge="*res://Scripts/DebugBridge.cs"

[dotnet]

project/assembly_name="FullThrust.Game"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/mode=3

[rendering]

renderer/rendering_method="forward_plus"
limits/global_shader_variables/buffer_size=262144
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/ssao/quality=1
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_debanding=true
scaling_3d/mode=1
scaling_3d/scale=0.75
