<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>FullThrust.Game</RootNamespace>

    <!-- Server GC plus Godot's native heaps produced AccessViolationException in terrain workers. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollector>true</ConcurrentGarbageCollector>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../sim/FullThrust.Sim.csproj" />
    <RuntimeHostConfigurationOption Include="System.Runtime.LegacyCorruptedStateExceptionPolicy" Value="true" />
  </ItemGroup>

</Project>
